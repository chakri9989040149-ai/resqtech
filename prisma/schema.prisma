// Aqua Senstial AI — Prisma Schema (SQLite default for local, PostgreSQL ready)
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String          @id @default(uuid())
  employeeId       String          @unique
  email            String          @unique
  name             String
  department       String
  designation      String
  role             String          @default("OFFICER")
  jurisdiction     String
  clearanceLevel   String          @default("Level 3")
  badgeNumber      String?
  phone            String?
  passwordHash     String?
  mfaEnabled       Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  auditLogs        AuditLog[]
}

model MonitoringSite {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  latitude    Float
  longitude   Float
  ward        String
  district    String
  elevation   Float
  sensors     Sensor[]
  createdAt   DateTime @default(now())
}

model Sensor {
  id             String          @id @default(uuid())
  siteId         String
  site           MonitoringSite  @relation(fields: [siteId], references: [id])
  sensorType     String          // ULTRASONIC_LEVEL, ACOUSTIC_FLOW, RAIN_GAUGE, CAMERA, TURBIDITY
  serialNumber   String          @unique
  status         String          @default("HEALTHY") // HEALTHY, WARNING, CRITICAL, FOULING_DETECTED, STALE
  batteryPercent Float           @default(100.0)
  signalDbm      Float           @default(-65.0)
  lastReadingAt  DateTime?
  readings       SensorReading[]
  healthRecords  DeviceHealth[]
  tickets        MaintenanceTicket[]
}

model SensorReading {
  id              String   @id @default(uuid())
  sensorId        String
  sensor          Sensor   @relation(fields: [sensorId], references: [id])
  timestamp       DateTime @default(now())
  waterLevelM     Float?
  flowVelocityMs  Float?
  rainfallMmHr    Float?
  blockageScore   Float?   // 0.0 to 1.0
  isPlausible     Boolean  @default(true)
  evidenceJson    String?  // Explanation of classification
}

model DeviceHealth {
  id             String   @id @default(uuid())
  sensorId       String
  sensor         Sensor   @relation(fields: [sensorId], references: [id])
  timestamp      DateTime @default(now())
  batteryPercent Float
  solarVolts     Float
  signalSnr      Float
  driftScore     Float    @default(0.0) // 0-1
  foulingFlag    Boolean  @default(false)
  flatlineFlag   Boolean  @default(false)
  healthScore    Float    @default(95.0) // 0-100
}

model DrainageBlockageIncident {
  id             String   @id @default(uuid())
  siteCode       String
  location       String
  severity       String   // CRITICAL, HIGH, MODERATE, LOW
  blockagePct    Float
  confidence     Float
  evidence       String
  status         String   @default("OPEN") // OPEN, DISPATCHED, RESOLVED, DISMISSED
  reportedAt     DateTime @default(now())
  verifiedBy     String?
}

model FloodIncident {
  id             String   @id @default(uuid())
  incidentCode   String   @unique
  zone           String
  severity       String   // CRITICAL, HIGH, CAUTION, NORMAL
  waterLevel     Float
  flowRate       Float
  rainfallRate   Float
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Alert {
  id             String   @id @default(uuid())
  alertCode      String   @unique
  title          String
  severity       String
  channels       String   // SMS, WHATSAPP, IVR_VOICE, WEB_PUSH, CAP_XML, SIREN
  contentEn      String
  contentTe      String?
  contentHi      String?
  signatureSha256 String?
  verificationCode String?
  status         String   @default("QUEUED") // QUEUED, SENT, DELIVERED, ACKNOWLEDGED
  createdAt      DateTime @default(now())
}

model RescueTeam {
  id             String   @id @default(uuid())
  callsign       String   @unique
  commander      String
  capacity       Int
  equipment      String
  status         String   @default("STANDBY") // STANDBY, DISPATCHED, ON_SCENE, RETURNING
  currentZone    String
}

model ReliefCamp {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  ward           String
  capacity       Int
  occupancy      Int      @default(0)
  foodStockDays  Float    @default(3.0)
  waterStockDays Float    @default(2.5)
  medicalStock   String   @default("ADEQUATE")
  adminContact   String
}

model DeliveryEvidence {
  id             String   @id @default(uuid())
  shipmentId     String
  campId         String
  photoUrl       String
  sha256Hash     String
  perceptualHash String?
  latitude       Float?
  longitude      Float?
  blurScore      Float    @default(0.92)
  isDuplicate    Boolean  @default(false)
  status         String   @default("PENDING_REVIEW") // PENDING_REVIEW, VERIFIED, REJECTED
  uploadedAt     DateTime @default(now())
}

model MaintenanceTicket {
  id             String   @id @default(uuid())
  ticketNumber   String   @unique
  sensorId       String?
  sensor         Sensor?  @relation(fields: [sensorId], references: [id])
  location       String
  issueType      String   // SILT_ACCUMULATION, SENSOR_DRIFT, HARDWARE_FAULT, PHYSICAL_BLOCKAGE
  status         String   @default("ASSIGNED") // REPORTED, ASSIGNED, IN_PROGRESS, COMPLETED, VERIFIED
  contractorName String
  slaHours       Int      @default(12)
  createdAt      DateTime @default(now())
  completedAt    DateTime?
}

model ParkingZone {
  id             String   @id @default(uuid())
  zoneName       String
  ward           String
  riskLevel      String   @default("HIGH")
  safeParkingLot String
  coordinatesJson String
}

model CriticalFacility {
  id             String   @id @default(uuid())
  name           String
  category       String   // HOSPITAL, SUBSTATION, SCHOOL, SHELTER, UNDERPASS
  elevationM     Float
  contactPerson  String
  phone          String
  nearestNode    String
  preAlertStatus String   @default("NORMAL")
}

model VulnerablePerson {
  id             String   @id @default(uuid())
  pseudonymId    String   @unique // e.g. VULN-W04-9812
  ward           String
  category       String   // ELDERLY, WHEELCHAIR, DIALYSIS_PATIENT, BEDRIDDEN
  mobilityScore  String
  emergencyPhone String
  verifiedAt     DateTime @default(now())
}

model AuditLog {
  id             String   @id @default(uuid())
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  action         String
  entityType     String
  entityId       String?
  detailsJson    String?
  ipAddress      String?
  timestamp      DateTime @default(now())
}
